{
  "name": "Flight Alert",
  "description": "Aircraft approaching home notifications",
  "version": "1.1.0",
  "manifest_version": 3,
  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://opensky-network.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
